#!/usr/bin/make -f

# Variables
NAME = order
VERSION = CHANGEVERSION

%:
	dh $@

override_dh_auto_install:
	mkdir -p usr/share/itsm-ng/plugins/$(NAME)
	find . -mindepth 1 -maxdepth 1 \
		! -name usr \
		! -name debian \
		! -name .git \
		! -name .github \
                ! -name tools \
                ! -name README.md \
		! -name composer.json \
		-exec cp -a {} usr/share/itsm-ng/plugins/$(NAME)/ \;

override_dh_gencontrol:
	dh_gencontrol -- -v$(VERSION)
